# Ruby dependencies needed to preview the site on your own computer.
#
# You only need this for local previews. GitHub Pages installs everything
# itself when it builds the live site.
#
#   conda activate jekyll
#   bundle install
#   bundle exec jekyll serve --livereload
#
# The `github-pages` gem pins Jekyll and its plugins to exactly the versions
# GitHub Pages uses, so what you see locally matches what goes live.

source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
end
